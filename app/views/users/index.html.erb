<div class="row">
  <div class="col-md-12">
    <div class="box-header with-border">
      <h3 class="box-title">Users</h3>
      <a href="<%= new_user_path %>" class="btn btn-xs btn-primary pull-right">Add user</a>
    </div>
    <div class="box">
      <!-- /.box-header -->
      <div class="box-body">
        <table class="table table-bordered">
          <thead>
            <tr>
              <th>Name</th>
              <th>E-mail</th>
              <th data-orderable="false" class="col-xs-1"></th>
            </tr>
          </thead>
          <tbody>
            <% @users.each do |user| %>
            <%# raise user.inspect %>
              <tr>
                <td><%= user.name %></td>
                <td><%= user.email %></td>
                <td class="col-xs-1">
                    <a href="<%= edit_user_path(user.id) %>" class="btn btn-sm btn-default" title="Edit"><i class="fa fa-pencil"></i></a>
                    <a href="<%= user_path(user.id) %>" class="btn btn-sm btn-default" title="Remove" data-method="delete" data-confirm="Are you sure you want to remove the user with the e-mail <%= user.email %>?"><i class="fa fa-trash"></i></a>
                  </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
