<div class="container">
  <div class="row my-5">
    <div class="col-12 col-sm-12 col-md-8 offset-md-2 col-lg-6 offset-lg-3">
      <div class="mb-5">
        <div class="text-uppercase text-center text-white mb-4"><%= t('login') %></div>

          <form class="new-session-login px-5 py-4" action="<%= sessions_path %>" method="POST">
            <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
            <div class="form-group mt-4">
              <label for="user-email">
                <%= t('email') %> <span class="text-danger">*</span>
              </label>

              <input type="email" name="email" class="form-control" id="user-email" value="" autocomplete="email">
            </div>

            <div class="form-groupp mt-4">
              <label for="user-password">
                <%= t('password') %> <span class="text-danger">*</span>
              </label>

              <input type="password" name="password" class="form-control" id="user-password" value="" autocomplete="password">
            </div>

            <div class="d-block d-sm-flex align-items-centerp mt-4">
              <input type="submit" value="Entrar" class="btn btn-primary ml-auto px-5" />
            </div>
          </form>

        </div>
      </div>
    </div>
  </div>
</div>
