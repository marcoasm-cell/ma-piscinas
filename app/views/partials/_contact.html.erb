<section class="container-fluid bg-primary py-5 position-relative" id="contact">
  <div id="contactbg">
    <div class="container position-relative">
      <div class="row">
        <div class="col-12 col-md-6 offset-md-3 text-white" style="bac">
          <h3>Solicitar Orçamento</h3>
          <form action="<%= contacts_path %>" method="POST">
            <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
            <div class="mt-3 mb-3">
              <label for="nome" class="form-label text-white">Nome *</label>
              <input type="text" class="form-control rounded-1" name="contact[name]" id="name" required>
            </div>
            <div class="mb-3">
              <label for="email" class="form-label text-white">E-mail *</label>
              <input type="email" class="form-control rounded-1" name="contact[email]" id="email" required>
            </div>
            <div class="mb-3">
              <label for="telefone" class="form-label text-white">Telefone *</label>
              <input type="tel" class="form-control rounded-1" name="contact[phone]" id="phone" required>
            </div>
            <div class="mb-3">
              <label for="mensagem" class="form-label text-white">Mensagem *</label>
              <textarea class="form-control rounded-1" name="contact[message]" id="message" rows="4" required></textarea>
            </div>
            <button type="submit" class="btn btn-primary rounded-1">Enviar Solicitação</button>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>