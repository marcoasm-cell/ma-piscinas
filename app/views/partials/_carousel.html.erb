<section class="container-fluid bg-black p-0">
  <div id="carouselExampleCaptions" class="carousel slide carousel-fade" data-bs-ride="carousel">
    <div class="carousel-indicators">
      <button type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
      <button type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide-to="1" aria-label="Slide 2"></button>
    </div>
    <div class="carousel-inner">
      <div class="carousel-item active" style="background-image: url(<%= asset_url('home/boia.jpg') %>)">
        <div class="carousel-overlay"></div>
        <div class="carousel-caption">
          <span class="hero-eyebrow">MA Piscinas · Sátão, Viseu</span>
          <h2 class="hero-title">Mergulhe connosco</h2>
          <p class="hero-text">Deixe o seu Verão vir ao de cima com a MA Piscinas.</p>
          <a href="/#contact" class="btn btn-outline-light btn-lg rounded-pill px-4 mt-2">Pedir orçamento</a>
        </div>
      </div>
      <div class="carousel-item" style="background-image: url(<%= asset_url('home/4.jpeg') %>)">
        <div class="carousel-overlay"></div>
        <div class="carousel-caption">
          <span class="hero-eyebrow">Construção · Canalização · Manutenção</span>
          <h2 class="hero-title">A sua piscina aqui</h2>
          <p class="hero-text">Projetos à medida, do primeiro esboço ao primeiro mergulho.</p>
          <a href="/#portfolio" class="btn btn-outline-light btn-lg rounded-pill px-4 mt-2">Ver portfólio</a>
        </div>
      </div>
    </div>
    <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide="prev">
      <span class="carousel-control-prev-icon" aria-hidden="true"></span>
      <span class="visually-hidden">Previous</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide="next">
      <span class="carousel-control-next-icon" aria-hidden="true"></span>
      <span class="visually-hidden">Next</span>
    </button>
    <a href="/#portfolio" class="scroll-hint" aria-label="Descer"><i class="fa-solid fa-chevron-down"></i></a>
  </div>
</section>
