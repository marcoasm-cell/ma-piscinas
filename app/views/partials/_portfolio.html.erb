<section class="section" id="portfolio">
  <div class="container">
    <div class="section-heading">
      <span class="section-eyebrow">Trabalhos realizados</span>
      <h2>Portfólio</h2>
    </div>
    <div class="portfolio-grid">
      <% %w[1.jpg 2_1.jpg 2_2.jpg 3_1.jpg 3_2.jpg 4.jpg 5.jpeg 6_1.jpg 6_2.jpg 7_1.jpg 7_2.jpg].each do |image| %>
        <a class="portfolio-item" href="<%= asset_url("portfolio/#{image}") %>" target="_blank">
          <img src="<%= asset_url("portfolio/#{image}") %>" alt="Piscina construída pela MA Piscinas" loading="lazy">
        </a>
      <% end %>
    </div>
  </div>
  <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Visualizador de imagens" aria-hidden="true">
    <span class="lightbox-counter"></span>
    <button type="button" class="lightbox-btn lightbox-close" aria-label="Fechar"><i class="fa-solid fa-xmark"></i></button>
    <button type="button" class="lightbox-btn lightbox-prev" aria-label="Anterior"><i class="fa-solid fa-chevron-left"></i></button>
    <img class="lightbox-image" alt="">
    <button type="button" class="lightbox-btn lightbox-next" aria-label="Seguinte"><i class="fa-solid fa-chevron-right"></i></button>
    <div class="lightbox-thumbs"></div>
  </div>
</section>
